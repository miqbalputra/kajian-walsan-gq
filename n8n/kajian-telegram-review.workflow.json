    {
      "id": "6f72e757-3f82-4ea4-94f5-64196664c570",
      "name": "Simpan Keputusan di Aplikasi",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        300,
        700
      ],
      "parameters": {
        "method": "POST",
        "url": "https://kajian.griyaquran.web.id/telegram/review/webhook",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {
          "timeout": 45000
        }
      }
