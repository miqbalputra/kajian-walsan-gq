      "typeVersion": 1.2,
      "position": [
        560,
        200
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendPhoto",
        "chatId": "1024607302",
        "file": "={{ $json.photo }}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "✅ Setujui",
                    "additionalFields": {
                      "callback_data": "={{ $json.reply_markup.inline_keyboard[0][0].callback_data }}"
                    }
                  },
                  {
                    "text": "❌ Tolak",
                    "additionalFields": {
                      "callback_data": "={{ $json.reply_markup.inline_keyboard[0][1].callback_data }}"
                    }
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "caption": "={{ $json.caption.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') }}",
          "parse_mode": "HTML"
        }
      },
      "webhookId": "3cd0ebb9-7da3-42a7-877f-6bcaf395b0e8",
      "credentials": {
        "telegramApi": {
          "id": "GM9dxJk9zAP0w9UX",
          "name": "GQ Admin Bot"
        }
      }
    },
    {
      "id": "b8afe4cc-e512-4fe2-adc7-b690f7b3dc81",
      "name": "Konfirmasi Pengiriman",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        840,
        200
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: Number($json.result?.message_id ?? $json.message_id ?? 0) > 0, result: $json.result ?? $json } }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "ec977d09-7476-4c15-ac0e-47543d082d24",
      "name": "Klik dan Start Admin",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.5,
      "position": [
        0,
        700
      ],
      "parameters": {
        "updates": [
          "callback_query",
          "message"
        ],
        "additionalFields": {
          "userIds": "1024607302"
        }
      },
      "webhookId": "0b4bdae3-c1cb-410a-9796-69c63f4f2db5",
      "credentials": {
        "telegramApi": {
          "id": "GM9dxJk9zAP0w9UX",
